# Copy to .env and fill in. Never commit .env.
# Point DATABASE_URL at a separate database for local work and tests:
# the admin tests read and write whatever database it names.

# Database (PostgreSQL)
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Clerk: admin sign-in
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/signin"
# The one account allowed into /admin
ADMIN_EMAIL="you@example.com"

# Cloudinary: image uploads and cleanup
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_PRESET=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# SMTP: contact form mail
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="you@example.com"
SMTP_PASS="app-password"
# Where contact messages go, unless an address is set in /admin/site/contact
CONTACT_EMAIL="you@example.com"

# Optional: canonical origin, no trailing slash (defaults to https://afifzilani.com)
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"
